{
  "name": "portal-inmobiliario",
  "private": true,
  "description": "Portal inmobiliario con pipeline de carga masiva, filtrado espacial sobre mapas vectoriales y alertas por zona",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @portal/backend",
    "dev:worker": "npm run dev:worker -w @portal/backend",
    "dev:web": "npm run dev -w @portal/frontend",
    "db:migrate": "npm run db:migrate -w @portal/backend",
    "db:seed": "npm run db:seed -w @portal/backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @portal/backend",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
