# Copia este archivo a .env (en la raíz). Lo leen backend y frontend.

# ---------- Backend ----------
NODE_ENV=development
PORT=3000
# PostgreSQL + PostGIS: datos, colas (pg-boss) y eventos en tiempo real (LISTEN/NOTIFY).
DATABASE_URL=postgres://portal:portal@localhost:5432/portal
# Base DEDICADA a tests de integración (npm run test:integration escribe datos en ella).
TEST_DATABASE_URL=postgres://portal:portal@localhost:5432/portal_test

# Secreto HS256 del access token (mínimo 32 caracteres). En producción, uno aleatorio.
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Orígenes permitidos (separados por coma) y cookie del refresh token
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=strict

# Almacenamiento de CSV subidos: local (backend/uploads) o s3 (S3 / MinIO / R2)
STORAGE_DRIVER=local
UPLOADS_DIR=./uploads
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
MAX_UPLOAD_MB=200

# Ingesta y alertas
IMPORT_BATCH_SIZE=2000
DIGEST_CRON=0 8 * * *

# Contraseña de los usuarios demo creados por `npm run db:seed` (solo desarrollo)
SEED_PASSWORD=Demo12345!

# ---------- Frontend (Vite) ----------
VITE_API_URL=/api
# Vacío = mismo origen (proxy de Vite en desarrollo). En otro dominio: https://api.tu-dominio.com
VITE_WS_URL=
